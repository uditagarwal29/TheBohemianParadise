# Copy to .env for local development. On Render, set these in the service's Environment tab.
# NEVER commit .env.

# MongoDB connection string (Atlas). Use a dedicated DB user with readWrite on this DB only.
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/tbp?retryWrites=true&w=majority

# Long random string (>= 32 bytes). `openssl rand -hex 32`
JWT_SECRET=
# Access-token lifetime, e.g. 7d, 12h
JWT_EXPIRES_IN=7d

# Google Sign-In. OAuth 2.0 Client ID of type "Web application" from
# https://console.cloud.google.com/apis/credentials ; the same value goes to the
# frontend build as VITE_GOOGLE_CLIENT_ID. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Comma-separated list of browser origins allowed to call the API.
# Leave empty when the frontend is served from this same service.
CORS_ORIGINS=

# Stripe (optional). Without STRIPE_SECRET_KEY only the "manual" payment method is offered.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Store settings
CURRENCY=inr
# Flat shipping charge in the smallest unit you price in (same unit as product.price).
SHIPPING_FLAT=0
# Order total above which shipping is free. 0 disables.
FREE_SHIPPING_ABOVE=0
# Minutes a checkout holds stock before an unpaid order is auto-cancelled.
RESERVATION_MINUTES=30

# Local dev only. Render injects PORT itself.
PORT=5000
HOST=127.0.0.1

# Product images. Leave CLOUDINARY_URL empty locally (files go to ./uploads). On Render set it:
# https://cloudinary.com -> Dashboard -> API environment variable, looks like cloudinary://key:secret@cloud
CLOUDINARY_URL=
CLOUDINARY_FOLDER=tbp
MAX_UPLOAD_MB=8
