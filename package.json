{
  "name": "tbp-backend",
  "version": "2.0.0",
  "description": "The Bohemian Paradise - backend API and static host for the storefront",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "dev:stack": "node scripts/dev-stack.js",
